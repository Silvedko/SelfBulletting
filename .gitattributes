# Unity .gitattributes without Git LFS.
# Based on https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes (MIT).
# LFS is intentionally not used: the prototype has almost no binary assets, and
# GitHub ZIP downloads must open in Unity without LFS pointer files.

# Macros
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# Docs and config
*.md                    text
*.json                  text
*.editorconfig          text
.editorconfig           text

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml

# Third-party plugins and the lock file: hide from GitHub stats and diffs
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

# Binary files: stored as regular git objects, never diffed or merged as text
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.psd                   binary
*.tga                   binary
*.tif                   binary
*.tiff                  binary
*.exr                   binary
*.hdr                   binary
*.fbx                   binary
*.FBX                   binary
*.obj                   binary
*.blend                 binary
*.wav                   binary
*.mp3                   binary
*.ogg                   binary
*.aif                   binary
*.aiff                  binary
*.mp4                   binary
*.mov                   binary
*.ttf                   binary
*.otf                   binary
*.dll                   binary
*.so                    binary
*.a                     binary
*.zip                   binary
*.unitypackage          binary
*.pdf                   binary
LightingData.asset      binary
